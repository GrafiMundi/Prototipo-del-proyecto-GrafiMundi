<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx/25"
            fx:controller="controller.CarritoController"
            stylesheets="@../styles/catalogo.css"
            styleClass="root">

    <!-- TOP -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <children>
                <Label text="GrafiMundi" styleClass="titulo"/>

                <!-- Empuja TODO a la derecha -->
                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnVolver"
                        text="Volver"
                        onAction="#volverAlCatalogo"
                        styleClass="boton-topbar"/>
            </children>
        </HBox>
    </top>

    <!-- CENTRO -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">

            <!-- TITULO CENTRADO -->
            <Label text="Carrito de compras"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

            <!-- CONTENIDO PRINCIPAL -->
            <HBox spacing="30" alignment="TOP_LEFT">

                <children>

                    <!-- IZQUIERDA: PRODUCTOS -->
                    <VBox spacing="15" prefWidth="900" VBox.vgrow="ALWAYS">

                        <children>

                            <ScrollPane fitToWidth="true"
                                        VBox.vgrow="ALWAYS"
                                        style="-fx-background-color: transparent;">

                                <content>
                                    <VBox fx:id="contenedorCarrito"
                                          spacing="15"
                                          style="-fx-padding: 10;
                                                 -fx-background-color: #f5f5f5;
                                                 -fx-background-radius: 10;"/>
                                </content>

                            </ScrollPane>

                        </children>

                    </VBox>

                    <!-- DERECHA: RESUMEN -->
                    <VBox prefWidth="350"
                          alignment="TOP_CENTER"
                          spacing="15"
                          style="-fx-padding: 25;
                                 -fx-background-color: white;
                                 -fx-border-color: #e0e0e0;
                                 -fx-border-radius: 15;
                                 -fx-background-radius: 15;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,5);">

                        <children>

                            <Label text="Resumen"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                            <HBox spacing="10">
                                <children>
                                    <Label text="Productos:"/>
                                    <Label fx:id="lblCantidad" text="0"/>
                                </children>
                            </HBox>

                            <HBox spacing="10">
                                <children>
                                    <Label text="Subtotal:"/>
                                    <Label fx:id="lblSubtotal" text="0"/>
                                </children>
                            </HBox>

                            <HBox spacing="10">
                                <children>
                                    <Label text="Total:"/>
                                    <Label fx:id="lblTotal" text="0"/>
                                </children>
                            </HBox>

                            <Region prefHeight="20"/>

                            <Button text="Continuar compra"
                                    styleClass="boton-comprar"
                                    maxWidth="Infinity"
                                    style="-fx-font-size: 16px; -fx-padding: 15;"/>

                        </children>

                    </VBox>

                </children>

            </HBox>

        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 15 25;">
            <children>
                <Label text="© 2026 GrafiMundi Colombia"
                       style="-fx-text-fill: #777; -fx-font-size: 13px;"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>