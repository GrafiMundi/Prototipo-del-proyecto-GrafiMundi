<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<BorderPane prefHeight="600.0" stylesheets="@../styles/catalogo.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CatalogoController">

    <!-- barra superior -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="topbar">
            
            <Label styleClass="titulo-topbar" text="GrafiMundi">
                <font>
                    <Font size="18" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button styleClass="boton-topbar" text="Carrito" />
            <Button styleClass="boton-topbar" text="Favoritos" />
            <Button fx:id="btnUsuario" styleClass="boton-usuario" text="Usuario" />
        </HBox>
    </top>

    <!-- contenido -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <!-- bienvenida -->
            <VBox spacing="10" maxWidth="900">
                <Label text="Bienvenido a GrafiMundi" styleClass="titulo"/>

                <TextFlow styleClass="contenedor-bienvenida">
                    <Text styleClass="descripcion-bienvenida"
                          text="La tienda líder en tarjetas gráficas en Colombia. Potencia tu PC con GPUs NVIDIA, AMD e Intel listas para instalar, jugar y rendir al máximo desde el primer momento. " />
                    <Text styleClass="descripcion-bienvenida"
                          text="Disfruta del mejor rendimiento, precios competitivos y marcas reconocidas como MSI, ASUS, Gigabyte, XFX, Aorus y ASRock." />
                </TextFlow>
            </VBox>

            <!-- filtros -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="Filtrar por:" />
                <Button styleClass="boton-topbar" text="Precio" />
                <Button styleClass="boton-topbar" text="Marca" />
            </HBox>

            <!-- scrollpane -->
            <ScrollPane fx:id="scrollPane"
                        fitToWidth="true"
                        style="-fx-background-color: transparent;">

                <content>
                    <FlowPane fx:id="contenedorGraficas" hgap="80" vgap="60" alignment="TOP_CENTER" prefWidth="Infinity" style="-fx-padding: 40 100 40 100;" />
                </content>

            </ScrollPane>

        </VBox>
    </center>

    <!-- footer -->
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="footer">
            <Label text="© 2026 GrafiMundi Colombia" />
        </HBox>
    </bottom>

</BorderPane>